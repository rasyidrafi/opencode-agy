{
  "name": "@rasyid_rafi/opencode-agy",
  "version": "0.1.0",
  "description": "OpenCode provider adapter for Google's official Antigravity ACP server",
  "license": "MIT",
  "type": "module",
  "main": "./opencode-agy.js",
  "module": "./opencode-agy.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./opencode-agy.js",
      "default": "./opencode-agy.js"
    }
  },
  "files": [
    "dist",
    "opencode-agy.js",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "bun test test",
    "test:live": "OPENCODE_AGY_ACP_LIVE=1 bun test test/acp-live.test.ts",
    "check": "npm run build && bun test test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@opencode-ai/plugin": "^1.18.26"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "antigravity",
    "agy",
    "anthropic-messages",
    "google"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rasyidrafi/opencode-agy.git"
  },
  "homepage": "https://github.com/rasyidrafi/opencode-agy#readme",
  "bugs": {
    "url": "https://github.com/rasyidrafi/opencode-agy/issues"
  }
}
