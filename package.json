{
  "name": "opencode-agy",
  "version": "0.1.0",
  "description": "OpenCode provider adapter for Google's official Antigravity agy CLI",
  "license": "MIT",
  "type": "module",
  "main": "./opencode-agy.js",
  "module": "./opencode-agy.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./opencode-agy.js",
      "default": "./opencode-agy.js"
    }
  },
  "files": [
    "dist",
    "opencode-agy.js",
    "README.md",
    "PLAN.md"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "bun test test",
    "test:live": "OPENCODE_AGY_LIVE=1 bun test test/agy-live.test.ts",
    "check": "npm run build && bun test test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.23"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "antigravity",
    "agy",
    "openai-compatible",
    "google"
  ]
}
